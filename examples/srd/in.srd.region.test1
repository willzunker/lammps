# Physics test #1: SRD gas in a static sphere region.
# Validates: no leaks, particle count conserved, uniform radial density,
# bin temperature matches Tsrd.
#
# Two variants in one file: set v_phantom externally with -var phantom 0|1
# to compare bare-bounceback vs. Lamura/Gompper virtual-particle fill.

units           lj
atom_style      atomic
dimension       3

variable        Rsphere  equal 5.0
variable        Lbox     equal ${Rsphere}+1.0
variable        Tsrd     equal 1.0
variable        msrd     equal 0.01

region          box block -${Lbox} ${Lbox} -${Lbox} ${Lbox} -${Lbox} ${Lbox}
create_box      1 box

region          gas sphere 0 0 0 ${Rsphere} side in
# dense MPCD regime: ~20 SRD per collision cell (M=20)
lattice         sc 20.0
create_atoms    1 region gas
mass            1 ${msrd}
velocity        all create ${Tsrd} 12345 loop geom

atom_modify     first empty
group           empty type 2

neighbor        0.3 bin
neigh_modify    delay 1 every 1 check no
comm_modify     group empty

timestep        0.02

# cell size gridsrd = 1.0 (-> ~20 SRD/cell with the lattice density above)
fix             1 all srd 1 NULL ${Tsrd} 1.0 49894 collision slip shift yes 73221
variable        phantom index yes
fix             2 all wall/srd/region gas phantom ${phantom}

# Radial-shell density profile, 50 shells from r=0 to r=Rsphere.
# Averaged over 4000 steps starting at step 1000 (after relaxation).
compute         shells all chunk/atom bin/sphere 0 0 0 0 ${Rsphere} 50 &
                units box discard yes
fix             prof all ave/chunk 10 400 4000 shells density/number &
                ave one file density.${phantom}.profile

# Equilibrate then sample.
thermo_style    custom step atoms temp f_1[9] f_2[1] f_2[2] f_2[3]
thermo          500
run             5000
